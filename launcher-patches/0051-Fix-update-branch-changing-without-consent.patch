From 85cde5cfbd6eaae8b67c7053f5641dc60c1981c1 Mon Sep 17 00:00:00 2001
From: RagedMeteor1837 <148640131+RagedMeteor1837@users.noreply.github.com>
Date: Sat, 6 Jun 2026 14:17:31 +0100
Subject: [PATCH] Fix update branch changing without consent


diff --git a/src/main/java/dev/figboot/olauncher/launcher/update/LauncherSelfUpdater.java b/src/main/java/dev/figboot/olauncher/launcher/update/LauncherSelfUpdater.java
index bf8ad76..9e6efd6 100644
--- a/src/main/java/dev/figboot/olauncher/launcher/update/LauncherSelfUpdater.java
+++ b/src/main/java/dev/figboot/olauncher/launcher/update/LauncherSelfUpdater.java
@@ -203,6 +203,14 @@ public class LauncherSelfUpdater {
             LOGGER.warn("Could not clear update cache before restart", ex);
         }
 
+        // olauncher - changes for https://github.com/RagedMeteor1837/olauncher/issues/16
+        try {
+            checker.prepareChannelForRestart(release.isPrerelease());
+        } catch (IOException ex) {
+            LOGGER.warn("Could not update build type flag before restart", ex);
+        }
+
+
         int choice = JOptionPane.showConfirmDialog(owner,
                 "Update downloaded and verified.\nThe launcher will now restart to apply " + release.getTagName() + ".",
                 "Restart to Update",
diff --git a/src/main/java/dev/figboot/olauncher/launcher/update/LauncherUpdateChecker.java b/src/main/java/dev/figboot/olauncher/launcher/update/LauncherUpdateChecker.java
index 5ed9944..7a2c95a 100644
--- a/src/main/java/dev/figboot/olauncher/launcher/update/LauncherUpdateChecker.java
+++ b/src/main/java/dev/figboot/olauncher/launcher/update/LauncherUpdateChecker.java
@@ -134,6 +134,13 @@ public class LauncherUpdateChecker {
         saveInfo();
     }
 
+
+    // olauncher - fix for https://github.com/RagedMeteor1837/olauncher/issues/16
+    public void prepareChannelForRestart(boolean newBuildIsDev) throws IOException {
+        info.setDevBuild(newBuildIsDev);
+        saveInfo();
+    }
+
     public void updateCheck() throws IOException {
         if (info == null) throw new IllegalStateException("Call loadInfo first!");
 
-- 
