@@ -0,0 +1,89 @@
+package dev.figboot.olauncher.launcher.update;
+
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+import javax.swing.*;
+import javax.swing.border.EmptyBorder;
+import java.awt.*;
+import java.awt.event.ActionEvent;
+import java.io.IOException;
+
+public class UpdateChannelDialog extends JDialog {
+    private static final Logger LOGGER = LogManager.getLogger();
+
+    private final LauncherUpdateChecker checker;
+    private JRadioButton rbStable;
+    private JRadioButton rbDev;
+
+    public UpdateChannelDialog(LauncherUpdateChecker checker) {
+        this.checker = checker;
+        SwingUtilities.invokeLater(this::initUI);
+    }
+
+    private void initUI() {
+        setModal(true);
+        setResizable(false);
+        setModalityType(ModalityType.APPLICATION_MODAL);
+        setDefaultCloseOperation(DISPOSE_ON_CLOSE);
+        setTitle("Update Channel");
+
+        JPanel root = new JPanel(new BorderLayout());
+        root.setBorder(new EmptyBorder(12, 12, 8, 12));
+
+        JLabel heading = new JLabel("Select update channel");
+        heading.setFont(heading.getFont().deriveFont(Font.BOLD, 14f));
+        heading.setBorder(new EmptyBorder(0, 0, 10, 0));
+        root.add(heading, BorderLayout.PAGE_START);
+
+        JPanel options = new JPanel();
+        options.setLayout(new BoxLayout(options, BoxLayout.Y_AXIS));
+
+        rbStable = new JRadioButton("<html><b>Stable</b> — Mainline releases from the master branch</html>");
+        rbDev    = new JRadioButton("<html><b>Dev</b> — Development builds from the dev branch</html>");
+
+        ButtonGroup group = new ButtonGroup();
+        group.add(rbStable);
+        group.add(rbDev);
+
+        if (checker.getChannel() == UpdateChannel.DEV) {
+            rbDev.setSelected(true);
+        } else {
+            rbStable.setSelected(true);
+        }
+
+        options.add(rbStable);
+        options.add(Box.createVerticalStrut(4));
+        options.add(rbDev);
+        root.add(options, BorderLayout.CENTER);
+
+        JPanel buttons = new JPanel(new FlowLayout(FlowLayout.RIGHT, 6, 0));
+        buttons.setBorder(new EmptyBorder(10, 0, 0, 0));
+
+        JButton btnOk = new JButton("OK");
+        btnOk.addActionListener(this::okClicked);
+        JButton btnCancel = new JButton("Cancel");
+        btnCancel.addActionListener(e -> dispose());
+
+        buttons.add(btnCancel);
+        buttons.add(btnOk);
+        root.add(buttons, BorderLayout.PAGE_END);
+
+        add(root);
+        pack();
+        setLocationRelativeTo(null);
+        setVisible(true);
+    }
+
+    private void okClicked(ActionEvent e) {
+        UpdateChannel selected = rbDev.isSelected() ? UpdateChannel.DEV : UpdateChannel.STABLE;
+        if (selected != checker.getChannel()) {
+            try {
+                checker.setChannel(selected);
+            } catch (IOException ex) {
+                LOGGER.error("Unable to switch update channel", ex);
+            }
+        }
+        dispose();
+    }
+}
