diff --git a/src/main/java/dev/figboot/olauncher/launcher/update/UpdateChannelDialog.java b/src/main/java/dev/figboot/olauncher/launcher/update/UpdateChannelDialog.java
new file mode 100644
index 0000000..9017a36
--- /dev/null
+++ b/src/main/java/dev/figboot/olauncher/launcher/update/UpdateChannelDialog.java
@@ -0,0 +1,130 @@
+package dev.figboot.olauncher.launcher.update;
+
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+import javax.swing.*;
+import javax.swing.border.CompoundBorder;
+import javax.swing.border.EmptyBorder;
+import javax.swing.border.TitledBorder;
+import java.awt.*;
+import java.awt.event.ActionEvent;
+import java.io.IOException;
+
+public class UpdateChannelDialog extends JDialog {
+    private static final Logger LOGGER = LogManager.getLogger();
+
+    private final LauncherUpdateChecker checker;
+    private JCheckBox cbEnabled;
+    private JRadioButton rbStable;
+    private JRadioButton rbDev;
+
+    public UpdateChannelDialog(LauncherUpdateChecker checker, JFrame owner) {
+        super(owner, "Update Preferences", true);
+        this.checker = checker;
+        SwingUtilities.invokeLater(this::initUI);
+    }
+
+    private void initUI() {
+        setResizable(false);
+        setDefaultCloseOperation(DISPOSE_ON_CLOSE);
+
+        JPanel root = new JPanel(new BorderLayout(0, 8));
+        root.setBorder(new EmptyBorder(10, 10, 8, 10));
+
+        // Sections
+        JPanel sections = new JPanel();
+        sections.setLayout(new BoxLayout(sections, BoxLayout.Y_AXIS));
+
+        // General section
+        JPanel generalPanel = new JPanel();
+        generalPanel.setLayout(new BoxLayout(generalPanel, BoxLayout.Y_AXIS));
+        generalPanel.setBorder(sectionBorder("General"));
+
+        cbEnabled = new JCheckBox("Check for updates automatically");
+        cbEnabled.setSelected(!checker.isCheckingDisabled());
+        cbEnabled.setAlignmentX(Component.LEFT_ALIGNMENT);
+        generalPanel.add(cbEnabled);
+
+        sections.add(generalPanel);
+        sections.add(Box.createVerticalStrut(8));
+
+        // Update Channel section
+        JPanel channelPanel = new JPanel();
+        channelPanel.setLayout(new BoxLayout(channelPanel, BoxLayout.Y_AXIS));
+        channelPanel.setBorder(sectionBorder("Update Channel"));
+
+        rbStable = new JRadioButton("<html><b>Stable</b> — Mainline releases from the master branch</html>");
+        rbDev    = new JRadioButton("<html><b>Dev</b> — Development builds from the dev branch</html>");
+        rbStable.setAlignmentX(Component.LEFT_ALIGNMENT);
+        rbDev.setAlignmentX(Component.LEFT_ALIGNMENT);
+
+        ButtonGroup group = new ButtonGroup();
+        group.add(rbStable);
+        group.add(rbDev);
+
+        if (checker.getChannel() == UpdateChannel.DEV) {
+            rbDev.setSelected(true);
+        } else {
+            rbStable.setSelected(true);
+        }
+
+        updateChannelEnabled();
+        cbEnabled.addActionListener(e -> updateChannelEnabled());
+
+        channelPanel.add(rbStable);
+        channelPanel.add(Box.createVerticalStrut(4));
+        channelPanel.add(rbDev);
+
+        sections.add(channelPanel);
+        root.add(sections, BorderLayout.CENTER);
+
+        // Buttons
+        JPanel buttons = new JPanel(new FlowLayout(FlowLayout.RIGHT, 6, 0));
+        JButton btnCancel = new JButton("Cancel");
+        JButton btnOk     = new JButton("OK");
+        btnCancel.addActionListener(e -> dispose());
+        btnOk.addActionListener(this::okClicked);
+        buttons.add(btnOk);
+        buttons.add(btnCancel);
+        root.add(buttons, BorderLayout.PAGE_END);
+
+        add(root);
+        pack();
+        setLocationRelativeTo(getOwner());
+        setVisible(true);
+    }
+
+    private void updateChannelEnabled() {
+        boolean enabled = cbEnabled.isSelected();
+        rbStable.setEnabled(enabled);
+        rbDev.setEnabled(enabled);
+    }
+
+    private void okClicked(ActionEvent e) {
+        boolean disableChecking = !cbEnabled.isSelected();
+        if (disableChecking != checker.isCheckingDisabled()) {
+            checker.setDisabled(disableChecking);
+        }
+
+        UpdateChannel selected = rbDev.isSelected() ? UpdateChannel.DEV : UpdateChannel.STABLE;
+        try {
+            if (!disableChecking && selected != checker.getChannel()) {
+                checker.setChannel(selected); // saves and triggers a re-check
+            } else {
+                checker.saveInfo();
+            }
+        } catch (IOException ex) {
+            LOGGER.error("Unable to save update preferences", ex);
+        }
+        dispose();
+    }
+
+    private static TitledBorder sectionBorder(String title) {
+        return new TitledBorder(
+                new CompoundBorder(
+                        BorderFactory.createEtchedBorder(),
+                        new EmptyBorder(4, 6, 6, 6)),
+                title);
+    }
+}
