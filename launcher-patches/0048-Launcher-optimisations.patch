     private ReleaseInfo queryLatestPrerelease() throws IOException {
         HttpURLConnection conn = openConnection(OLauncherConstants.GITHUB_RELEASES_URL);
-        if (conn.getResponseCode() / 100 != 2) {
-            LOGGER.error("Error response from server: {} {}", new Object[]{conn.getResponseCode(), conn.getResponseMessage()});
-            return null;
-        }
-        try (Reader r = new BufferedReader(new InputStreamReader(conn.getInputStream()))) {
-            ReleaseInfo[] releases = gson.fromJson(r, ReleaseInfo[].class);
-
-            ReleaseInfo latestPrerelease = Arrays.stream(releases)
-                    .filter(ReleaseInfo::isPrerelease)
-                    .max(Comparator.comparing(ReleaseInfo::getCreatedAt))
-                    .orElse(null);
-
-            // A stable release flagged with "dev-channel: true" is also offered on the dev channel, but only if no newer dev release exists
-            ReleaseInfo latestFlaggedStable = Arrays.stream(releases)
-                    .filter(rel -> !rel.isPrerelease() && rel.isDevChannelFlagged())
-                    .max(Comparator.comparing(ReleaseInfo::getCreatedAt))
-                    .orElse(null);
-
-            if (latestPrerelease == null) return latestFlaggedStable;
-            if (latestFlaggedStable == null) return latestPrerelease;
-            return latestFlaggedStable.getCreatedAt().isAfter(latestPrerelease.getCreatedAt())
-                    ? latestFlaggedStable : latestPrerelease;
+        try {
+            if (conn.getResponseCode() / 100 != 2) {
+                LOGGER.error("Error response from server: {} {}", new Object[]{conn.getResponseCode(), conn.getResponseMessage()});
+                return null;
+            }
+            try (Reader r = new BufferedReader(new InputStreamReader(conn.getInputStream()))) {
+                ReleaseInfo[] releases = gson.fromJson(r, ReleaseInfo[].class);
+
+                ReleaseInfo latestPrerelease = Arrays.stream(releases)
+                        .filter(ReleaseInfo::isPrerelease)
+                        .max(Comparator.comparing(ReleaseInfo::getCreatedAt))
+                        .orElse(null);
+
+                // A stable release flagged with "dev-channel: true" is also offered on the dev channel, but only if no newer dev release exists
+                ReleaseInfo latestFlaggedStable = Arrays.stream(releases)
+                        .filter(rel -> !rel.isPrerelease() && rel.isDevChannelFlagged())
+                        .max(Comparator.comparing(ReleaseInfo::getCreatedAt))
+                        .orElse(null);
+
+                if (latestPrerelease == null) return latestFlaggedStable;
+                if (latestFlaggedStable == null) return latestPrerelease;
+                return latestFlaggedStable.getCreatedAt().isAfter(latestPrerelease.getCreatedAt())
+                        ? latestFlaggedStable : latestPrerelease;
+            }
+        } finally {
+            conn.disconnect();
         }
     }
 
