--- a/src/main/java/com/mojang/launcher/OperatingSystem.java
+++ b/src/main/java/com/mojang/launcher/OperatingSystem.java
@@ -1,8 +1,11 @@
 package com.mojang.launcher;
 
+import java.io.BufferedReader;
 import java.io.File;
 import java.io.IOException;
+import java.io.InputStreamReader;
 import java.net.URI;
+import java.util.Locale;
 import org.apache.logging.log4j.LogManager;
 import org.apache.logging.log4j.Logger;
 
@@ -13,6 +16,7 @@ public enum OperatingSystem {
     UNKNOWN("unknown", new String[0]);
 
     private static final Logger LOGGER = LogManager.getLogger();
+    private static volatile String systemArch;
     private final String name;
     private final String[] aliases;
 
@@ -60,6 +64,60 @@ public enum OperatingSystem {
         return UNKNOWN;
     }
 
+    // olauncher - changes for https://github.com/RagedMeteor1837/olauncher/issues/7
+    public static String getSystemArch() {
+        if (systemArch == null) {
+            systemArch = detectSystemArch();
+        }
+        return systemArch;
+    }
+
+    private static String detectSystemArch() {
+        OperatingSystem os = getCurrentPlatform();
+        if (os == WINDOWS) {
+            String wow64Arch = System.getenv("PROCESSOR_ARCHITEW6432");
+            if (wow64Arch != null && !wow64Arch.isEmpty()) {
+                return normalizeArch(wow64Arch);
+            }
+            String arch = System.getenv("PROCESSOR_ARCHITECTURE");
+            if (arch != null && !arch.isEmpty()) {
+                return normalizeArch(arch);
+            }
+        } else {
+            try {
+                Process proc = Runtime.getRuntime().exec(new String[]{"uname", "-m"});
+                try (BufferedReader reader = new BufferedReader(new InputStreamReader(proc.getInputStream()))) {
+                    String line = reader.readLine();
+                    if (line != null && !line.trim().isEmpty()) {
+                        return normalizeArch(line.trim());
+                    }
+                }
+            } catch (IOException e) {
+                LOGGER.warn("Failed to detect system architecture via uname -m, falling back to os.arch", e);
+            }
+        }
+        return System.getProperty("os.arch");
+    }
+
+    private static String normalizeArch(String arch) {
+        switch (arch.toLowerCase(Locale.ROOT)) {
+            case "x86_64":
+            case "amd64":
+                return "amd64";
+            case "arm64":
+            case "aarch64":
+                return "aarch64";
+            case "x86":
+            case "i386":
+            case "i486":
+            case "i586":
+            case "i686":
+                return "x86";
+            default:
+                return arch.toLowerCase(Locale.ROOT);
+        }
+    }
+
