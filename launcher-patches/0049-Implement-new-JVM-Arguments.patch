+    // olauncher start - resolves https://github.com/RagedMeteor1837/olauncher/issues/14
+    private void syncPresetWithCurrentVersion() {
+        MinecraftVersionManager vm = (MinecraftVersionManager)
+                this.minecraftLauncher.getLauncher().getVersionManager();
+        String versionId = this.profile.getLastVersionId();
+        VersionSyncInfo syncInfo = vm.getVersionSyncInfo(versionId);
+        if (syncInfo == null) {
+            for (VersionSyncInfo info : vm.getVersions(null)) {
+                if (info.getLatestVersion().getId().equals(versionId)) {
+                    syncInfo = info;
+                    break;
+                }
+            }
+        }
+        if (syncInfo == null || syncInfo.getLatestVersion() == null) return;
+        onVersionChanged(syncInfo.getLatestVersion());
+    }
+
+    void onLockReleased() {
+        if (this.lastKnownVersion != null) {
+            onVersionChanged(this.lastKnownVersion);
+        } else {
+            syncPresetWithCurrentVersion();
+        }
+    }
+
+    public void onVersionChanged(Version version) {
+        this.lastKnownVersion = version;
+        if (this.profile.isLockJvmArgs()) return;
+        if (this.profile.getJavaArgs() == null) {
+            if (this.javaInfoPanel != null) this.javaInfoPanel.refreshDisplay();
+            return;
+        }
+        if (!OperatingSystem.getSystemArch().contains("64")) return;
+        JvmPresetTier oldTier;
+        String stored = this.profile.getJvmPreset();
+        if (stored == null) {
+            oldTier = JvmPresetTier.detectFromArgs(this.profile.getJavaArgs());
+        } else {
+            try {
+                oldTier = JvmPresetTier.valueOf(stored);
+            } catch (IllegalArgumentException e) {
+                return;
+            }
+        }
+        JvmPresetTier newTier = JvmPresetTier.forVersion(version.getId(), version.getReleaseTime());
+        if (newTier == oldTier) return;
+        this.profile.setJavaArgs(newTier.swapInto(this.profile.getJavaArgs(), oldTier));
+        this.profile.setJvmPreset(newTier.name());
+        if (this.javaInfoPanel != null) this.javaInfoPanel.refreshDisplay();
+    }
+    // olauncher end
+
