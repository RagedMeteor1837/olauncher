@@ -0,0 +1,201 @@
+// JvmPresetTier.java
+// Resolves https://github.com/RagedMeteor1837/olauncher/issues/14
+
+package dev.figboot.olauncher.launcher;
+
+import net.minecraft.launcher.profile.Profile;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+import java.util.*;
+import java.util.stream.Collectors;
+
+public enum JvmPresetTier {
+    LEGACY, G1GC, ZGC;
+
+    private static final Logger LOGGER = LogManager.getLogger();
+
+    // 1.14 release date — anything before this is LEGACY
+    private static final Date LEGACY_DATE_CUTOFF;
+    // 26.x release date — anything on or after this is ZGC
+    private static final Date ZGC_DATE_CUTOFF;
+
+    private static final Set<String> ALL_PRESET_TOKENS;
+    private static Boolean zgcSupported;
+
+    static {
+        Calendar cal = Calendar.getInstance(TimeZone.getTimeZone("UTC"));
+        cal.set(2019, Calendar.APRIL, 23, 0, 0, 0);
+        cal.set(Calendar.MILLISECOND, 0);
+        LEGACY_DATE_CUTOFF = cal.getTime();
+
+        cal.set(2026, Calendar.JANUARY, 1, 0, 0, 0);
+        cal.set(Calendar.MILLISECOND, 0);
+        ZGC_DATE_CUTOFF = cal.getTime();
+
+        ALL_PRESET_TOKENS = new HashSet<>();
+        for (JvmPresetTier t : values()) {
+            Collections.addAll(ALL_PRESET_TOKENS, t.getDefaultArgs().split(" "));
+        }
+    }
+
+    public String getDefaultArgs() {
+        switch (this) {
+            case ZGC:  return Profile.DEFAULT_JRE_ARGUMENTS_64BIT_26;
+            case G1GC: return Profile.DEFAULT_JRE_ARGUMENTS_64BIT_14;
+            default:   return Profile.DEFAULT_JRE_ARGUMENTS_64BIT;
+        }
+    }
+
+
+    // Returns true if ZGC can be used on the current OS
+    // On Windows, ZGC requires build 17134 (1803) or later; Linux and macOS are assumed fine
+    public static boolean isZgcSupported() {
+        if (zgcSupported != null) return zgcSupported;
+        zgcSupported = detectZgcSupport();
+        return zgcSupported;
+    }
+
+    private static boolean detectZgcSupport() {
+        String os = System.getProperty("os.name", "").toLowerCase(java.util.Locale.ROOT);
+        if (!os.contains("win")) {
+            LOGGER.info("ZGC support: true");
+            return true;
+        }
+        if (System.getProperty("olauncher.winTenSpoof") != null) {
+            LOGGER.info("ZGC support: --winTen spoof active, true");
+            return true;
+        }
+        try {
+            Process p = Runtime.getRuntime().exec(new String[]{
+                "reg", "query",
+                "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion",
+                "/v", "CurrentBuildNumber"});
+            try (java.io.BufferedReader r = new java.io.BufferedReader(
+                    new java.io.InputStreamReader(p.getInputStream()))) {
+                String line;
+                while ((line = r.readLine()) != null) {
+                    line = line.trim();
+                    if (line.startsWith("CurrentBuildNumber")) {
+                        String[] tok = line.split("\\s+");
+                        int build = Integer.parseInt(tok[tok.length - 1]);
+                        boolean supported = build >= 17134;
+                        LOGGER.info("ZGC support: {}",
+                                supported ? "true" : "false");
+                        return supported;
+                    }
+                }
+            }
+        } catch (Exception e) {
+            LOGGER.warn("ZGC support: registry query failed, assuming false");
+        }
+        return false;
+    }
+
+    public static JvmPresetTier forVersion(String versionId, Date releaseTime) {
+        JvmPresetTier tier = forVersionUncapped(versionId, releaseTime);
+        if (tier == ZGC && !isZgcSupported()) return G1GC;
+        return tier;
+    }
+
+    private static JvmPresetTier forVersionUncapped(String versionId, Date releaseTime) {
+        if (versionId != null && !versionId.startsWith("latest-")) {
+            if (isOldVersionId(versionId)) return LEGACY;
+
+            JvmPresetTier t = tryParseSegment(versionId);
+            if (t != null) return t;
+
+            String[] segments = versionId.split("-");
+            for (int i = segments.length - 1; i >= 0; i--) {
+                t = tryParseSegment(segments[i]);
+                if (t != null) return t;
+            }
+        }
+
+        if (releaseTime != null) {
+            if (!releaseTime.before(ZGC_DATE_CUTOFF)) return ZGC;
+            if (!releaseTime.before(LEGACY_DATE_CUTOFF)) return G1GC;
+            return LEGACY;
+        }
+        return G1GC; // unknown, safe middle-ground default
+    }
+
+    private static boolean isOldVersionId(String id) {
+        if (id.startsWith("rd-") || id.startsWith("inf-")) return true;
+        if (id.length() >= 2) {
+            char c = id.charAt(0);
+            if ((c == 'a' || c == 'b' || c == 'c') && Character.isDigit(id.charAt(1))) return true;
+        }
+        return false;
+    }
+
+
+    private static JvmPresetTier tryParseSegment(String seg) {
+        String[] parts = seg.split("\\.");
+        if (parts.length < 1) return null;
+        try {
+            int major = Integer.parseInt(parts[0]);
+            if (major >= 26) return ZGC;
+            if (major == 1 && parts.length >= 2) {
+                try {
+                    int minor = Integer.parseInt(parts[1]);
+                    return minor >= 14 ? G1GC : LEGACY;
+                } catch (NumberFormatException ignored) {}
+            }
+        } catch (NumberFormatException ignored) {}
+        return null;
+    }
+
+    public static JvmPresetTier detectFromArgs(String args) {
+        if (args == null) return null;
+        if (args.contains("-XX:+UseZGC")) return ZGC;
+        if (args.contains("-XX:+UseG1GC")) return G1GC;
+        if (args.contains("-XX:+UseConcMarkSweepGC")) return LEGACY;
+        return null;
+    }
+
+    public String swapInto(String currentArgs, JvmPresetTier oldTier) {
+        if (oldTier != null && this == oldTier) return currentArgs;
+        Set<String> remove = (oldTier != null)
+                ? new HashSet<>(Arrays.asList(oldTier.getDefaultArgs().split(" ")))
+                : ALL_PRESET_TOKENS;
+
+        List<String> kept = Arrays.stream(currentArgs.split("\\s+"))
+                .filter(t -> !t.isEmpty() && !remove.contains(t))
+                .collect(Collectors.toList());
+
+        Map<String, String> userByBase = new LinkedHashMap<>();
+        for (String t : kept) userByBase.put(flagBase(t), t);
+
+        Set<String> substituted = new HashSet<>();
+        List<String> result = new ArrayList<>();
+
+        for (String presetToken : this.getDefaultArgs().split(" ")) {
+            String base = flagBase(presetToken);
+            if (userByBase.containsKey(base)) {
+                result.add(userByBase.get(base));
+                substituted.add(base);
+            } else {
+                result.add(presetToken);
+            }
+        }
+
+        for (String t : kept) {
+            if (!substituted.contains(flagBase(t))) result.add(t);
+        }
+
+        return String.join(" ", result);
+    }
+
+    // Returns the "base" of a JVM flag, stripping the value portion.
+    private static String flagBase(String token) {
+        if (token.startsWith("-X") && !token.startsWith("-XX:")) {
+            int i = 0;
+            while (i < token.length() && !Character.isDigit(token.charAt(i))) i++;
+            return i < token.length() ? token.substring(0, i) : token;
+        }
+        int eq = token.indexOf('=');
+        if (eq >= 0) return token.substring(0, eq);
+        return token;
+    }
+}
