-            release = queryLatestStableRelease();
-        }
+        ReleaseInfo release = info.getChannel() == UpdateChannel.DEV
+                ? queryLatestPrerelease()
+                : queryLatestStableRelease();
 
         if (release == null) {
             LOGGER.warn("No suitable release found on the {} channel.", new Object[]{info.getChannel()});
@@ -177,7 +158,7 @@ public class LauncherUpdateChecker {
     private ReleaseInfo queryLatestStableRelease() throws IOException {
         HttpURLConnection conn = openConnection(GITHUB_LATEST_RELEASE_URL);
         if (conn.getResponseCode() / 100 != 2) {
-            LOGGER.error("Error response code returned by server: " + conn.getResponseCode() + " " + conn.getResponseMessage());
+            LOGGER.error("Error response from server: {} {}", new Object[]{conn.getResponseCode(), conn.getResponseMessage()});
             return null;
         }
         try (Reader r = new BufferedReader(new InputStreamReader(conn.getInputStream()))) {
@@ -188,7 +169,7 @@ public class LauncherUpdateChecker {
     private ReleaseInfo queryLatestPrerelease() throws IOException {
         HttpURLConnection conn = openConnection(GITHUB_RELEASES_URL);
