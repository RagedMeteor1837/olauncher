@@ -64,15 +64,13 @@ public class LauncherUpdateChecker {
             info = gson.fromJson(r, LauncherUpdateInfo.class);
         }
 
-        // Migrate existing installs that pre-date the channel field.
-        if (info.getChannel() == null) {
-            info.setChannel(LauncherVersion.getInstance().isDevVersion() ? UpdateChannel.DEV : UpdateChannel.STABLE);
-        }
-
-        // If a dev build is launched against a stable-channel config, switch to DEV.
-        if (LauncherVersion.getInstance().isDevVersion() && info.getChannel() == UpdateChannel.STABLE) {
-            LOGGER.info("Dev build launched with stable channel config — switching to DEV update channel.");
-            info.setChannel(UpdateChannel.DEV);
+        // Auto-switch when the build type changes (e.g. stable build installed over dev, or vice versa).
+        // User manual channel changes do not update devBuild, so their preference persists as long as the same build type is running.
+        if (info.getChannel() == null || currentlyDev != info.isDevBuild()) {
+            LOGGER.info("Build type {}, switching update channel to {}.",
+                    new Object[]{info.getChannel() == null ? "unknown (migration)" : "changed", buildChannel});
+            info.setChannel(buildChannel);
+            info.setDevBuild(currentlyDev);
             info.setLastCheck(Instant.MIN);
             info.setLatestRelease(null);
             saveInfo();
@@ -91,10 +89,9 @@ public class LauncherUpdateChecker {
         return info != null ? info.getChannel() : UpdateChannel.STABLE;
     }
 
-    // Switches the update channel and immediately triggers a fresh check against the new channel. 
     public void setChannel(UpdateChannel channel) throws IOException {
         if (info == null) throw new IllegalStateException("Call loadInfo first!");
-        LOGGER.info("Switching update channel from {} to {}.", new Object[]{info.getChannel(), channel});
+        LOGGER.info("User switching update channel from {} to {}.", new Object[]{info.getChannel(), channel});
         info.setChannel(channel);
         info.setLastCheck(Instant.MIN);
         info.setLatestRelease(null);
