-            LOGGER.error("Error response code returned by server: " + conn.getResponseCode() + " " + conn.getResponseMessage());
+            LOGGER.error("Error response from server: {} {}", new Object[]{conn.getResponseCode(), conn.getResponseMessage()});
             return null;
         }
         try (Reader r = new BufferedReader(new InputStreamReader(conn.getInputStream()))) {
@@ -222,9 +203,15 @@ public class LauncherUpdateChecker {
         boolean shouldUpdate = channelSwitchPending || shouldShowUpdateDialog(release);
         channelSwitchPending = false;
 
-        if (shouldUpdate) {
-            new UpdateAvailableDialog(this, release);
+        if (!shouldUpdate) return;
+
+        if (LauncherVersion.getInstance().isDirty()) {
+            LOGGER.info("Update available ({}) but notification suppressed for dirty build.",
+                    new Object[]{release.getTagName()});
+            return;
         }
+
+        new UpdateAvailableDialog(this, release);
     }
 
     private boolean shouldShowUpdateDialog(ReleaseInfo release) {
