+    // olauncher - vanilla launcher profile types that track the latest version
+    private static boolean isLatestType(String type) {
+        return "latest-release".equals(type) || "latest-snapshot".equals(type);
+    }
+
+    // olauncher start
+    // https://github.com/RagedMeteor1837/olauncher/issues/20
+    private void ensureLatestProfiles() {
+        for (String latestType : new String[]{"latest-release", "latest-snapshot"}) {
+            String generatedName = latestType.equals("latest-release") ? "Latest Version" : "Latest Snapshot";
+            Profile untyped = null;
+            boolean found = false;
+            for (Profile profile : this.profiles.values()) {
+                if (latestType.equals(profile.getType())) {
+                    found = true;
+                    break;
+                }
+                if (untyped == null && profile.getType() == null && generatedName.equals(profile.getName()) && latestType.equals(profile.getLastVersionId())) {
+                    untyped = profile;
+                }
+            }
+            if (found) {
+                continue;
+            }
+            if (untyped != null) {
+                // Adopt the profile an older olauncher version saved without its type
+                untyped.setType(latestType);
+                continue;
+            }
+            String key = UUIDGenerator.generate();
+            Profile profile = new Profile(generatedName);
+            profile.setUniqueName(key);
+            profile.setType(latestType);
+            profile.setLastVersionId(latestType);
+            this.profiles.put(key, profile);
+            LOGGER.info("Created profile " + generatedName);
+        }
+    }
+    // olauncher end
