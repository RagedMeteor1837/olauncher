+// LauncherSelfUpdater.java
+
+package dev.figboot.olauncher.launcher.update;
+
+import com.mojang.launcher.OperatingSystem;
+import dev.figboot.olauncher.launcher.LauncherVersion;
+import net.minecraft.launcher.Launcher;
+import net.minecraft.launcher.Main;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+import javax.swing.*;
+import javax.swing.border.EmptyBorder;
+import java.awt.*;
+import java.io.*;
+import java.net.HttpURLConnection;
+import java.net.Proxy;
+import java.net.URL;
+import java.nio.file.Files;
+import java.nio.file.StandardCopyOption;
+import java.security.DigestInputStream;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.jar.JarFile;
+
+public class LauncherSelfUpdater {
+    private static final Logger LOGGER = LogManager.getLogger();
+    private static final String EXPECTED_MAIN_CLASS = "dev.figboot.autool.AutoOL";
+
+    private final LauncherUpdateChecker checker;
+    private final ReleaseInfo release;
+    private final ReleaseInfo.Asset asset;
+
+    public LauncherSelfUpdater(LauncherUpdateChecker checker, ReleaseInfo release, ReleaseInfo.Asset asset) {
+        this.checker = checker;
+        this.release = release;
+        this.asset = asset;
+    }
+
+    public void startUpdate(Component parent) {
+        Frame ownerFrame = (parent != null)
+                ? (Frame) SwingUtilities.getAncestorOfClass(Frame.class, parent)
+                : null;
+
+        JDialog dlg = new JDialog(ownerFrame, "Downloading Update", true);
+        dlg.setDefaultCloseOperation(JDialog.DO_NOTHING_ON_CLOSE);
+        dlg.setLayout(new BorderLayout(10, 10));
+
+        JLabel statusLabel = new JLabel("Preparing download...");
+        statusLabel.setBorder(new EmptyBorder(10, 15, 5, 15));
+
+        long totalBytes = asset.getSize();
+        JProgressBar progressBar = new JProgressBar(0, totalBytes > 0 ? (int) Math.min(totalBytes, Integer.MAX_VALUE) : 100);
+        progressBar.setBorder(new EmptyBorder(0, 15, 0, 15));
+        progressBar.setStringPainted(true);
+        if (totalBytes <= 0) progressBar.setIndeterminate(true);
+
+        JButton cancelButton = new JButton("Cancel");
+        JPanel btnPanel = new JPanel(new FlowLayout(FlowLayout.CENTER));
+        btnPanel.setBorder(new EmptyBorder(0, 0, 5, 0));
+        btnPanel.add(cancelButton);
+
+        dlg.add(statusLabel, BorderLayout.NORTH);
+        dlg.add(progressBar, BorderLayout.CENTER);
+        dlg.add(btnPanel, BorderLayout.SOUTH);
+        dlg.pack();
+        dlg.setMinimumSize(new Dimension(420, dlg.getHeight()));
+        dlg.setLocationRelativeTo(ownerFrame);
+
+        SwingWorker<File, Void> worker = new SwingWorker<File, Void>() {
+            @Override
+            protected File doInBackground() throws Exception {
+                return downloadAsset(statusLabel, progressBar);
+            }
+
+            @Override
+            protected void done() {
+                dlg.dispose();
+                if (isCancelled()) return;
+                try {
+                    File jar = get();
+                    onDownloadComplete(jar, ownerFrame);
+                } catch (java.util.concurrent.ExecutionException ex) {
+                    Throwable cause = ex.getCause() != null ? ex.getCause() : ex;
+                    LOGGER.error("Update download failed", cause);
+                    JOptionPane.showMessageDialog(ownerFrame,
+                            "Update failed:\n" + cause.getMessage(),
+                            "Update Error", JOptionPane.ERROR_MESSAGE);
+                } catch (Exception ex) {
+                    LOGGER.error("Unexpected error during update", ex);
+                }
+            }
+        };
+
+        cancelButton.addActionListener(e -> worker.cancel(true));
+        worker.execute();
+        dlg.setVisible(true);
+    }
+
+    private File downloadAsset(JLabel statusLabel, JProgressBar progressBar) throws Exception {
+        File workDir = Launcher.getCurrentInstance().getLauncher().getWorkingDirectory();
+        File autoolDir = new File(workDir, "autool");
+        if (!autoolDir.isDirectory()) autoolDir.mkdirs();
+
+        File tempFile = File.createTempFile("olauncher-update-", ".jar.tmp", autoolDir);
+        tempFile.deleteOnExit();
+
+        try {
+            SwingUtilities.invokeLater(() -> statusLabel.setText("Downloading " + asset.getName() + "..."));
+            LOGGER.info("Downloading update from {}", asset.getDownloadURL());
+
+            Proxy proxy = Launcher.getCurrentInstance().getLauncher().getProxy();
+            MessageDigest sha256 = newSha256();
+            long downloaded = 0;
+            long total = asset.getSize();
+
+            HttpURLConnection conn = openConnection(asset.getDownloadURL(), proxy);
+            try (InputStream raw = conn.getInputStream();
+                 DigestInputStream in = new DigestInputStream(new BufferedInputStream(raw), sha256);
+                 OutputStream out = new BufferedOutputStream(new FileOutputStream(tempFile))) {
+
+                byte[] buf = new byte[8192];
+                int read;
+                while ((read = in.read(buf)) != -1) {
+                    if (Thread.currentThread().isInterrupted()) {
+                        throw new InterruptedException("Download cancelled by user");
+                    }
+                    out.write(buf, 0, read);
+                    downloaded += read;
+                    final long dl = downloaded;
+                    SwingUtilities.invokeLater(() -> {
+                        if (total > 0) {
+                            progressBar.setValue((int) Math.min(dl, Integer.MAX_VALUE));
+                            progressBar.setString(String.format("%.0f / %.0f KB", dl / 1024.0, total / 1024.0));
+                        } else {
+                            progressBar.setString(String.format("%.0f KB", dl / 1024.0));
+                        }
+                    });
+                }
+            } finally {
+                conn.disconnect();
+            }
+
+            SwingUtilities.invokeLater(() -> statusLabel.setText("Verifying..."));
+
+            // SHA-256 check — requires release notes to contain: redist-sha256: <64 hex chars>
+            String expectedSha256 = release.getRedistSha256();
+            String actualSha256 = bytesToHex(sha256.digest());
+            if (expectedSha256 != null) {
+                if (!actualSha256.equalsIgnoreCase(expectedSha256)) {
+                    throw new IOException(
+                            "SHA-256 mismatch — the download may be corrupt or tampered with.\n"
+                            + "Expected: " + expectedSha256 + "\n"
+                            + "Got:      " + actualSha256);
+                }
+                LOGGER.info("SHA-256 verified OK: {}", actualSha256);
+            } else {
+                LOGGER.warn("Release notes contain no redist-sha256; skipping cryptographic hash check.");
+            }
+
+            // Structural check — must be a valid JAR with the expected main class
+            try (JarFile jar = new JarFile(tempFile)) {
+                String mainClass = jar.getManifest().getMainAttributes().getValue("Main-Class");
+                if (!EXPECTED_MAIN_CLASS.equals(mainClass)) {
+                    throw new IOException(
+                            "Downloaded JAR has unexpected Main-Class: " + mainClass
+                            + " (expected " + EXPECTED_MAIN_CLASS + ")");
+                }
+            }
+
+            // Move to final destination (replace any previous download)
+            File finalJar = new File(autoolDir, asset.getName());
+            Files.move(tempFile.toPath(), finalJar.toPath(), StandardCopyOption.REPLACE_EXISTING);
+            LOGGER.info("Update staged at {}", finalJar.getAbsolutePath());
+            return finalJar;
+
+        } catch (Exception ex) {
+            tempFile.delete();
+            throw ex;
+        }
+    }
+
+    private void onDownloadComplete(File newJar, Frame ownerFrame) {
+        try {
+            checker.clearCacheForUpdate();
+        } catch (IOException ex) {
+            LOGGER.warn("Could not clear update cache before restart", ex);
+        }
+
+        int choice = JOptionPane.showConfirmDialog(ownerFrame,
+                "Update downloaded and verified.\nThe launcher will now restart to apply " + release.getTagName() + ".",
+                "Restart to Update",
+                JOptionPane.OK_CANCEL_OPTION,
+                JOptionPane.INFORMATION_MESSAGE);
+        if (choice != JOptionPane.OK_OPTION) return;
+
+        try {
+            restart(newJar);
+        } catch (IOException ex) {
+            LOGGER.error("Failed to launch new version", ex);
+            JOptionPane.showMessageDialog(ownerFrame,
+                    "Restart failed:\n" + ex.getMessage(),
+                    "Restart Error", JOptionPane.ERROR_MESSAGE);
+        }
+    }
+
+    private void restart(File newJar) throws IOException {
+        String javaHome = System.getProperty("java.home");
+        String javaExe = javaHome + File.separator + "bin" + File.separator
+                + (OperatingSystem.getCurrentPlatform() == OperatingSystem.WINDOWS ? "javaw.exe" : "java");
+
+        if (!new File(javaExe).isFile()) {
+            // Fallback: try plain "java" on PATH
+            javaExe = "java";
+        }
+
+        List<String> cmd = new ArrayList<>();
+        cmd.add(javaExe);
+        cmd.add("-jar");
+        cmd.add(newJar.getAbsolutePath());
+        cmd.addAll(Arrays.asList(Main.getLaunchArgs()));
+
+        LOGGER.info("Restarting: {}", String.join(" ", cmd));
+        new ProcessBuilder(cmd).inheritIO().start();
+        System.exit(0);
+    }
+
+    private static HttpURLConnection openConnection(URL url, Proxy proxy) throws IOException {
+        int hops = 0;
+        while (hops++ < 5) {
+            HttpURLConnection conn = (HttpURLConnection) (proxy != null && !proxy.equals(Proxy.NO_PROXY)
+                    ? url.openConnection(proxy) : url.openConnection());
+            conn.setRequestProperty("User-Agent",
+                    "OLauncher/" + LauncherVersion.getVersion() + " (auto-updater)");
+            conn.setConnectTimeout(10_000);
+            conn.setReadTimeout(60_000);
+            conn.setInstanceFollowRedirects(false);
+
+            int status = conn.getResponseCode();
+            if (status == HttpURLConnection.HTTP_MOVED_PERM
+                    || status == HttpURLConnection.HTTP_MOVED_TEMP
+                    || status == 307 || status == 308) {
+                String loc = conn.getHeaderField("Location");
+                conn.disconnect();
+                if (loc == null) throw new IOException("Redirect with no Location header");
+                url = new URL(loc);
+                continue;
+            }
+            if (status / 100 != 2) {
+                throw new IOException("Server returned HTTP " + status + " " + conn.getResponseMessage()
+                        + " for " + url);
+            }
+            return conn;
+        }
+        throw new IOException("Too many redirects");
+    }
+
+    private static MessageDigest newSha256() {
+        try {
+            return MessageDigest.getInstance("SHA-256");
+        } catch (NoSuchAlgorithmException ex) {
+            throw new RuntimeException("SHA-256 not available", ex);
+        }
+    }
+
+    private static String bytesToHex(byte[] bytes) {
+        StringBuilder sb = new StringBuilder(bytes.length * 2);
+        for (byte b : bytes) sb.append(String.format("%02x", b));
+        return sb.toString();
+    }
+}
