Subject: [PATCH] actually actually fix updates now


diff --git a/pom.xml b/pom.xml
index 13ad9bd..c9bd104 100644
--- a/pom.xml
+++ b/pom.xml
@@ -119,6 +119,7 @@
                                 <property>^git.closest.tag.commit.count$</property>
                                 <property>^git.dirty$</property>
                                 <property>^git.commit.id.abbrev$</property>
+                                <property>^git.commit.id$</property>
                             </includeOnlyProperties>
                         </configuration>
                     </execution>
diff --git a/src/main/java/dev/figboot/olauncher/launcher/LauncherVersion.java b/src/main/java/dev/figboot/olauncher/launcher/LauncherVersion.java
index 5e73013..79768c7 100644
--- a/src/main/java/dev/figboot/olauncher/launcher/LauncherVersion.java
+++ b/src/main/java/dev/figboot/olauncher/launcher/LauncherVersion.java
@@ -39,7 +39,7 @@ public final class LauncherVersion {
         return new LauncherVersion(innerProps, outerProps);
     }
 
-    @Getter private final String tag, commitId;
+    @Getter private final String tag, commitId, fullCommitId;
     private final String tagSan;
     @Getter private final boolean dirty, devVersion;
 
@@ -58,6 +58,7 @@ public final class LauncherVersion {
                 || outer.getProperty("git.dirty").equalsIgnoreCase("true");
 
         commitId = outer.getProperty("git.commit.id.abbrev");
+        fullCommitId = outer.getProperty("git.commit.id");
     }
 
     private LauncherVersion() {
@@ -66,6 +67,7 @@ public final class LauncherVersion {
         devVersion = true;
         dirty = false;
         commitId = "???";
+        fullCommitId = null;
     }
 
     @Override
diff --git a/src/main/java/dev/figboot/olauncher/launcher/update/LauncherUpdateChecker.java b/src/main/java/dev/figboot/olauncher/launcher/update/LauncherUpdateChecker.java
index 9bef326..1c93978 100644
--- a/src/main/java/dev/figboot/olauncher/launcher/update/LauncherUpdateChecker.java
+++ b/src/main/java/dev/figboot/olauncher/launcher/update/LauncherUpdateChecker.java
@@ -216,8 +216,13 @@ public class LauncherUpdateChecker {
 
     private boolean shouldShowUpdateDialog(ReleaseInfo release) {
         if (info.getChannel() == UpdateChannel.DEV) {
+            String fullCommitId = LauncherVersion.getInstance().getFullCommitId();
+            String buildSha = release.getBuildSha();
+            if (fullCommitId != null && buildSha != null) {
+                return !buildSha.equalsIgnoreCase(fullCommitId);
+            }
             String commitId = LauncherVersion.getInstance().getCommitId();
-            return commitId != null && !release.getTagName().endsWith(commitId);
+            return commitId == null || !release.getTagName().contains(commitId);
         } else {
             String curTag = LauncherVersion.getInstance().getTag();
             return release.getTagName().compareTo(curTag) > 0;
diff --git a/src/main/java/dev/figboot/olauncher/launcher/update/ReleaseInfo.java b/src/main/java/dev/figboot/olauncher/launcher/update/ReleaseInfo.java
index 15b307a..99c5a2c 100644
--- a/src/main/java/dev/figboot/olauncher/launcher/update/ReleaseInfo.java
+++ b/src/main/java/dev/figboot/olauncher/launcher/update/ReleaseInfo.java
@@ -44,6 +44,17 @@ public class ReleaseInfo {
         return body;
     }
 
+    public String getBuildSha() {
+        if (body == null) return null;
+        for (String line : body.split("\r?\n")) {
+            if (line.startsWith("build-sha:")) {
+                String sha = line.substring("build-sha:".length()).trim();
+                if (sha.matches("[0-9a-fA-F]{40}")) return sha;
+            }
+        }
+        return null;
+    }
+
     public List<Asset> getAssets() {
         return Collections.unmodifiableList(assets);
     }
